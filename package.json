{
  "name": "stream-animations",
  "version": "2.1.2",
  "description": "Visually consistent HTML5 Canvas animations for OBS stream overlays",
  "type": "module",
  "scripts": {
    "dev:stinger": "npx serve src/stinger",
    "dev:background": "npx serve src/background",
    "dev:sidebar": "npx serve src/sidebar",
    "dev:shade": "npx serve src/shade",
    "dev:epcot": "npx serve src/epcot",
    "dev:notifications": "npx serve src/notifications",
    "dev": "vite",
    "build": "npm run build:stinger && npm run build:background && npm run build:sidebar && npm run build:shade && npm run build:notifications && npm run build:epcot",
    "build:stinger": "vite build --mode stinger",
    "build:background": "vite build --mode background",
    "build:sidebar": "vite build --mode sidebar",
    "build:shade": "vite build --mode shade",
    "build:notifications": "vite build --mode notifications",
    "build:epcot": "vite build --mode epcot",
    "watch": "vite build --watch --mode stinger & vite build --watch --mode background & vite build --watch --mode sidebar & vite build --watch --mode shade & vite build --watch --mode notifications & vite build --watch --mode epcot",
    "watch:stinger": "vite build --watch --mode stinger",
    "watch:background": "vite build --watch --mode background",
    "watch:sidebar": "vite build --watch --mode sidebar",
    "watch:shade": "vite build --watch --mode shade",
    "watch:notifications": "vite build --watch --mode notifications",
    "watch:epcot": "vite build --watch --mode epcot",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "bench": "node tools/benchmark/run.js",
    "motion": "node tools/motion/run.js",
    "motion:export": "node tools/motion/export.js",
    "design:figures": "node tools/design/figures.js",
    "motion:compare": "node tools/motion/compare.js",
    "debug:collect": "node tools/debug/collect.js",
    "pages:stage": "npm run build && bash tools/pages/stage.sh",
    "pages:smoke": "node tools/pages/smoke.js"
  },
  "keywords": [
    "obs",
    "stream",
    "animation",
    "overlay",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fast-check/vitest": "^0.2.4",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "fast-check": "^4.5.3",
    "jsdom": "^27.4.0",
    "puppeteer-core": "^25.0.4",
    "serve": "^14.2.4",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.16",
    "vitest-canvas-mock": "^1.1.3"
  }
}
